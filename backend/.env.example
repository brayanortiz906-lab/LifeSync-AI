# Backend Environment Variables
# Copia este archivo a .env y completa los valores

# Supabase (obligatorio)
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
DATABASE_URL=postgresql+asyncpg://postgres:password@db.tu-proyecto.supabase.co:6543/postgres

# Encriptación para API keys de usuarios (BYOK) - genera con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=tu-clave-32-bytes-base64-aqui

# App
APP_NAME=LifeAgente
DEBUG=false
ENVIRONMENT=production
FRONTEND_URL=https://tu-dominio.com
CORS_ORIGINS=["https://tu-dominio.com"]
API_V1_PREFIX=/api/v1

# Google OAuth (opcional - para Calendar/Drive)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email (opcional - para notificaciones)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@tu-dominio.com

# Cron/Autopiloto
CRON_TOKEN=token-secreto-para-cron