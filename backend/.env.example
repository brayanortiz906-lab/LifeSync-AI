# LifeAgente AI - configuracion del backend
# Copiar a .env y ajustar. NUNCA commitear el .env real.
# Todas las variables son OPCIONALES: sin ninguna, la app funciona igual
# (modo local + motor de reglas). MIRA MANUAL-LOCAL.md seccion 4.

# Clave maestra para cifrar las API Keys guardadas (Fernet/AES).
# Si la dejas vacia, se genera sola y se guarda en %APPDATA%\LifeAgente\secreto.txt
# (estable entre ejecuciones, para poder descifrar lo que ya guardaste).
# Para fijarla a mano: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_SECRET_KEY=

# Base de datos (SQLite en el prototipo; Postgres en produccion).
# Si la dejas vacia se usa %APPDATA%\LifeAgente\lifesync.db
DATABASE_URL=

# Carpeta de datos (util para una instalacion portable).
# LIFEAGENTE_DATA=C:\LifeAgente

# Proveedor de IA por defecto:
#   mock | demo | openai | gemini | anthropic | openrouter | ollama | lmstudio
# "mock" permite demostrar el prototipo SIN API Key (clasificador local por reglas).
DEFAULT_LLM_PROVIDER=mock
DEFAULT_OPENAI_MODEL=gpt-4o-mini
DEFAULT_GEMINI_MODEL=gemini-2.0-flash

# --------------------------------------------------------------------------
# Acceso con cuenta (el paso tecnico lo hace UNA vez quien instala).
# Crear el ID de cliente OAuth de tipo "App de escritorio" en:
#   https://console.cloud.google.com/apis/credentials
# Con esto se activan: entrar con un clic, Google Drive (respaldo),
# Google Calendar (importar agenda) y el resumen por correo.
# --------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
OUTLOOK_CLIENT_ID=
GITHUB_CLIENT_ID=

# --------------------------------------------------------------------------
# Envio del codigo de verificacion por correo.
# Sin SMTP el codigo se muestra en pantalla (modo desarrollo).
# En Render (plan gratis) SMTP esta bloqueado: usa la API de Gmail (gmail.send).
# --------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_DESDE=

# Token que protege POST /api/permisos/ejecutar-todos.
# Lo usa la tarea diaria de GitHub Actions (.github/workflows/daily.yml).
CRON_TOKEN=

# Preferencias del usuario (se pueden sobreescribir por usuario en Ajustes)
DEFAULT_CURRENCY=COP
DAY_START=07:00
DAY_END=22:00
DEFAULT_TIMEZONE=America/Bogota

# CORS: origenes permitidos, separados por comas.
# Si sirves la interfaz en GitHub Pages, anade:
#   https://brayanortiz906-lab.github.io
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000
