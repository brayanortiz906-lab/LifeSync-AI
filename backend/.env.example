# =============================================================================
# LifeAgente AI v2.1.0 - Backend Environment Variables
# Copia este archivo a .env y completa los valores
# =============================================================================

# -----------------------------------------------------------------------------
# APP CONFIG
# -----------------------------------------------------------------------------
APP_NAME=LifeAgente
DEBUG=true
ENVIRONMENT=local
API_V1_PREFIX=/api/v1
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "capacitor://localhost"]

# -----------------------------------------------------------------------------
# SUPABASE (OBLIGATORIO - Consigue en https://supabase.com/dashboard/project/_/settings/api)
# -----------------------------------------------------------------------------
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9... (clave pública anon)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9... (clave service_role - SECRETA)

# Database URL para asyncpg (usar pooler puerto 6543)
# Formato: postgresql+asyncpg://postgres:PASSWORD@db.TU_PROYECTO.supabase.co:6543/postgres
DATABASE_URL=postgresql+asyncpg://postgres:TU_PASSWORD@db.tu-proyecto.supabase.co:6543/postgres

# -----------------------------------------------------------------------------
# ENCRYPTION (OBLIGATORIO - Para encriptar API keys BYOK de usuarios)
# Genera con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# -----------------------------------------------------------------------------
ENCRYPTION_KEY=pon_aqui_tu_clave_fernet_32_bytes_base64

# -----------------------------------------------------------------------------
# GOOGLE OAUTH (OPCIONAL - Para Google Sign-In, Calendar, Drive)
# Consigue en: https://console.cloud.google.com/apis/credentials
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-tu_secret_aqui

# -----------------------------------------------------------------------------
# EMAIL (OPCIONAL - Para notificaciones, magic links, reset password)
# Opciones: SMTP, Brevo (Sendinblue), Resend
# -----------------------------------------------------------------------------
# SMTP
SMTP_HOST=smtp.tu-proveedor.com
SMTP_PORT=587
SMTP_USER=tu-email@dominio.com
SMTP_PASSWORD=tu-password-smtp
EMAIL_FROM=noreply@tu-dominio.com

# O Brevo (https://brevo.com)
# BREVO_API_KEY=xkeysib-tu-api-key

# O Resend (https://resend.com)
# RESEND_API_KEY=re_tu-api-key

# -----------------------------------------------------------------------------
# CRON / AUTOPILOTO (Para endpoints programados)
# -----------------------------------------------------------------------------
CRON_TOKEN=token-secreto-para-cron-jobs

# -----------------------------------------------------------------------------
# GEMINI (Ya no se usa global - es BYOK por usuario)
# Cada usuario pone SU propied API key en Ajustes > IA
# -----------------------------------------------------------------------------
# GEMINI_API_KEY= (ya no se usa)