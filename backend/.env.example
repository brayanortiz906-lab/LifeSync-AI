# LifeSync AI — configuración del backend
# Copiar a .env y ajustar. NUNCA commitear el .env real.

# Clave maestra para cifrar las API Keys guardadas (Fernet/AES).
# Generar una nueva con:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_SECRET_KEY=changeme-genera-una-clave-fernet-real

# Base de datos (SQLite en el prototipo; Postgres en producción)
DATABASE_URL=sqlite:///./lifesync.db

# Proveedor de IA por defecto: mock | openai | gemini
# "mock" permite demostrar el prototipo SIN API Key (clasificador local por reglas).
DEFAULT_LLM_PROVIDER=mock
DEFAULT_OPENAI_MODEL=gpt-4o-mini
DEFAULT_GEMINI_MODEL=gemini-2.0-flash

# ID de cliente OAuth de Google (opcional).
# Si lo defines, el boton "Continuar con Google" del Centro de Conexiones
# conecta SIN que el usuario pege nada (un solo clic).
# Crear en: https://console.cloud.google.com/apis/credentials  (tipo "App de escritorio")
GOOGLE_CLIENT_ID=

# Preferencias del usuario (se pueden sobreescribir por usuario)
DEFAULT_CURRENCY=COP
DAY_START=07:00
DAY_END=22:00
DEFAULT_TIMEZONE=America/Bogota

# CORS del frontend en desarrollo
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
