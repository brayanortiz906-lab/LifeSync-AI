    "@tanstack/react-query": "^5.28.0",
    "lucide-react": "^0.372.0",
    "date-fns": "^3.6.0",
    "marked": "^12.0.0",
    "@capacitor/core": "^6.1.0",
    "@capacitor/android": "^6.1.0",
    "@capacitor/ios": "^6.1.0",
    "@capacitor/cli": "^6.1.0",
    "@capacitor/local-notifications": "^6.0.0",
